# PanHub 部署环境变量模板
# 使用方法：cp .env.example .env，然后按需修改

# ===== 搜索审计（推荐启用，需配合 docker compose --profile audit 启动 mongo）=====

# MongoDB 连接串（容器间用服务名 mongo；如启用认证则带账号密码）
SEARCH_AUDIT_MONGO_URL=mongodb://mongo:27017

# MongoDB 数据库名
SEARCH_AUDIT_MONGO_DB=panhub_audit

# 审计管理后台访问令牌（访问 /audit 页面用，请改成你自己的长随机串，建议 32 位以上）
SEARCH_AUDIT_ADMIN_TOKEN=请改成你自己的长随机串

# ===== 可选 =====

# 搜索密码门（非空时搜索需输入密码，Cookie 30 天有效）
# SEARCH_PASSWORD=

# MongoDB 审计集合名（默认 search_audit_logs）
# SEARCH_AUDIT_MONGO_COLLECTION=search_audit_logs

# 审计保留天数（默认 360，仅影响新写入记录）
# SEARCH_AUDIT_RETENTION_DAYS=360

# 审计写入超时毫秒（默认 1000，本地冷启动慢可调大到 5000）
# SEARCH_AUDIT_WRITE_TIMEOUT_MS=1000

# ===== MongoDB 认证（可选，生产建议启用）=====
# 取消 docker-compose.yml 里 mongo 服务的 environment 注释，并填下面两项
# 同时把 SEARCH_AUDIT_MONGO_URL 改为 mongodb://用户:密码@mongo:27017
# MONGO_USER=panhub
# MONGO_PASS=改成强密码
